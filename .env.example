# Copy with ./scripts/init-env.sh — it fills the secrets for you.

# Public hostname pointing to this server (A/AAAA record). Use "localhost" for a local test.
DOMAIN=n8n.example.com
# Email for Let's Encrypt expiry notices (optional)
ACME_EMAIL=

# Pin versions; upgrade deliberately (see README → Upgrades)
N8N_VERSION=2.49.7
POSTGRES_VERSION=17
CADDY_VERSION=2.11

TIMEZONE=Europe/Berlin

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=__GENERATE__

# Encrypts all stored credentials. Back it up separately — without it, backups are useless.
N8N_ENCRYPTION_KEY=__GENERATE__

# Execution pruning: max age in hours (336 = 14 days) and max rows
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Monitoring
STUCK_AFTER_MINUTES=60
# Optional: Slack/Discord/Mattermost-compatible webhook for alerts
ALERT_WEBHOOK_URL=
