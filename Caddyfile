{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Prometheus metrics stay on the internal Docker network
	handle /metrics* {
		respond 404
	}

	handle {
		reverse_proxy n8n:5678
	}
}
